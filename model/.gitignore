# ML project (model/). Generated data and weights stay local; code, configs, label mappings,
# split files, experiment metrics and reports stay trackable. NOTE: .gitignore never untracks
# files that are already committed (e.g. the frozen split and dataset metadata, kept on purpose).

# ---------------------------------------------------------------- Python environment and caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# ---------------------------------------------------------------- secrets
.env
.env.*
!.env.example

# ---------------------------------------------------------------- datasets and generated data
# temporary video download cache
data/raw/
# per-batch download folders of the extractor
data/**/lm_batch_*/
data/**/*.mp4
data/**/*.mov
data/**/*.avi
data/**/*.mkv
data/**/*.webm
data/**/*.zip
data/**/*.tar
data/**/*.tar.gz
data/**/*.tgz
data/**/*.7z
data/**/*.rar
# landmark .npz per video (hundreds of MB; regenerated by s2_02)
data/landmarks/**/arrays/
data/**/*.npy
data/**/*.npz
data/**/*.tmp
data/**/*.tmp.*
data/metadata/probe_parts/*.tmp

# ---------------------------------------------------------------- model weights / checkpoints
# exported weights (best_model.pt) ...
/models/*
# ... but keep the class mapping needed for inference
!/models/*.json
*.pt
*.pth
*.ckpt
*.onnx
*.joblib
*.safetensors
*.tflite
*.h5
*.pkl
# synthetic smoke-test stores
experiments/_stores/

# ---------------------------------------------------------------- logs, temp, OS
# run logs (metrics are in experiments/*/metadata.json)
*.log
logs/
*.tmp
*.swp
*~
.DS_Store
Thumbs.db
