# Optional environment variables for the ML pipeline (model/). The scripts read them from the
# process environment (export them in your shell); nothing loads this file automatically.
# Never commit real values.

# Hugging Face read-only token: avoids HTTP 429 rate limits when downloading dataset videos.
# Sent only to huggingface.co (see src/asl/landmarks/cloud.py). Leave empty if not needed.
HF_TOKEN=

# CA bundle for HTTPS downloads. Needed with the python.org Python 3.12 build on macOS,
# which has no CA store of its own.
SSL_CERT_FILE=/etc/ssl/cert.pem
