# Template for the Next.js app. Copy to .env.local and fill in real values:
#   cp .env.example .env.local
# Never commit .env / .env.local (they are git-ignored). Placeholders only below.

# MongoDB connection string used by src/lib/dbConnect.ts.
# Local example: mongodb://127.0.0.1:27017/<database-name>
# Atlas example: mongodb+srv://<user>:<password>@<cluster-host>/<database-name>
MONGODB_URI=mongodb://127.0.0.1:27017/your_database_name

# Session signing secret used by src/lib/auth.ts. Use a random value of at least 32 characters,
# e.g. generate one with:  openssl rand -base64 48
SESSION_SECRET=replace_with_a_long_random_secret
